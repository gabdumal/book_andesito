{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["./src/components/*"],
      "@constants": ["./src/constants.ts"]
    },
    "verbatimModuleSyntax": true
  },
  "exclude": ["dist", "node_modules"],
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"]
}
